# Soundscapes Conservatory of Music - environment variables
# Copy to .env and export the values in your shell before running the app
# (the app reads os.environ directly; it does not load .env files itself).

# SMTP account used by the contact form (Office 365 by default)
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional overrides
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_RECIPIENT=info@example.org   # where contact messages go; defaults to MAIL_USERNAME

# Local development: set to 1 to exercise the contact form without sending real email
MAIL_SUPPRESS_SEND=1

# Port for `python app.py` (Fly.io provides this in production)
PORT=8080
