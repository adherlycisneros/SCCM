# Soundscapes Conservatory of Music - environment variables
# Copy to .env and export the values in your shell before running the app
# (the app reads os.environ directly; it does not load .env files itself).

# Gmail account the contact form sends from, with a Gmail App Password (the account needs
# 2-Step Verification). Every message is sent from this address.
MAIL_USERNAME=
MAIL_PASSWORD=

# Inbox that receives contact messages (the owner's Outlook mailbox in production).
# Falls back to MAIL_USERNAME when unset.
MAIL_RECIPIENT=

# Optional overrides
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587

# Local development: set to 1 to exercise the contact form without sending real email
MAIL_SUPPRESS_SEND=1

# Port for `python app.py` (Fly.io provides this in production)
PORT=8080
